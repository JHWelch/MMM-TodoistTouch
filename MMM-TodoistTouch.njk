{% if loading %}
  <div class="dimmed light">{{ "LOADING" | translate | safe }}</div>
{% else %}
  <header class="space-between">
    <span>{{ "TASKS" | translate }}</span>
  </header>

  <ul class="list">
    {% for task in tasks %}
      <li class="task-list-item">
        <form
          action="/task/{{ task.id }}/close"
          method="POST"
          onsubmit="event.preventDefault(); const form = event.currentTarget; fetch(form.action, { method: form.method, headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' }, body: new URLSearchParams(new FormData(form)).toString(), }).catch((error) => console.error('Failed to close task', error)); return false;"
        >
          <button class="close-button" type="submit">
            <span class="fa fa-square-check"></span>
          </button>
        </form>

        <span>{{ task.content | truncate(20) }}</span>
      </li>
    {% endfor %}
  </ul>
{% endif %}
