{% if loading %}
  <div class="dimmed light">{{ "LOADING" | translate | safe }}</div>
{% else %}
  <header class="space-between">
    <span>{{ "TASKS" | translate }}</span>
  </header>

  <ul class="list">
    {% for task in tasks %}
      <li class="list-item">
        <span>{{ task.content | truncate(20) }}</span>
      </li>
    {% endfor %}
  </ul>
{% endif %}
